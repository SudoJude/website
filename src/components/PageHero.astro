---
// Dark dotted hero used at the top of listing pages (portfolio, blog, art).
// The page must pass `dark` to <Layout> so the header is drawn in cream over it.
interface Props {
  title: string;
}
const { title } = Astro.props;
---

<section class="page-hero dots-dark">
  <div class="inner"><h1>{title}</h1></div>
</section>

<style>
  .page-hero { padding: 9rem 0 5.3rem; }
  .inner { padding: 0 4%; }
  h1 { font-size: clamp(2.4rem, 5vw, 4.5rem); margin: 0; }
  @media (max-width: 700px) { .page-hero { padding-bottom: 3rem; } }
</style>
