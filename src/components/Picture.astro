---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { isSquarespace } from '../lib/media.mjs';

interface Props {
  src: ImageMetadata | string;
  alt?: string;
  width?: number;
  class?: string;
}
const { src, alt = '', width = 750, ...rest } = Astro.props;
// Squarespace images are resized by their CDN and local ones by Astro. R2 images (cdn.judemyers.eu)
// are served as uploaded, so `width` has no effect on them: export them at the size you need.
const remote = typeof src === 'string' ? (isSquarespace(src) ? `${src}?format=${width}w` : src) : '';
---

{
  typeof src === 'string' ? (
    <img src={remote} {alt} loading="lazy" {...rest} />
  ) : (
    <Image {src} {alt} {width} loading="lazy" {...rest} />
  )
}
