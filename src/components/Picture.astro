---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata | string;
  alt?: string;
  width?: number;
  class?: string;
}
const { src, alt = '', width = 750, ...rest } = Astro.props;
// Remote Squarespace images are resized by their CDN; local ones by Astro.
const remote = typeof src === 'string' ? (src.includes('squarespace-cdn') ? `${src}?format=${width}w` : src) : '';
---

{
  typeof src === 'string' ? (
    <img src={remote} {alt} loading="lazy" {...rest} />
  ) : (
    <Image {src} {alt} {width} loading="lazy" {...rest} />
  )
}
