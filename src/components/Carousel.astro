---
// Reusable horizontal carousel with prev/next buttons. Children are the slides.
//
//   <Carousel>…slides…</Carousel>                       wraps around, centred slide, neighbours peek
//   <Carousel loop={false}>…</Carousel>                 plain scroll-snap track, no wrapping
//   <Carousel height="clamp(220px, 31vw, 450px)" gap="0">  <img …/> <img …/> </Carousel>
//
// Props: loop (default true), align ('center' | 'start', defaults to center when looping),
// gap (CSS length between slides), height (fixed height for <img> slides), class, label.
// Markdown galleries in project pages produce the same markup (src/lib/rehype-project.mjs).
import './carousel.css';

interface Props {
  loop?: boolean;
  align?: 'center' | 'start';
  gap?: string;
  height?: string;
  class?: string;
  label?: string;
}
const { loop = true, align = loop ? 'center' : 'start', gap, height, class: className, label = 'Image carousel' } = Astro.props;
const style = [gap && `--carousel-gap:${gap}`, height && `--carousel-height:${height}`].filter(Boolean).join(';');
---

<div
  class:list={['carousel', className]}
  data-carousel
  data-align={align}
  data-loop={loop ? '' : undefined}
  role="group"
  aria-roledescription="carousel"
  aria-label={label}
  style={style || undefined}
>
  <div class="carousel-track"><slot /></div>
  <button class="carousel-nav prev" type="button" aria-label="Previous" data-dir="-1">←</button>
  <button class="carousel-nav next" type="button" aria-label="Next" data-dir="1">→</button>
</div>

<script>
  import './carousel.ts';
</script>
