---
import '@fontsource/ibm-plex-sans/400.css';
import '@fontsource/ibm-plex-sans/700.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/700.css';
import { site, nav, socials, url } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  dark?: boolean; // dark hero behind the header
  image?: string; // absolute URL for social previews
  type?: 'website' | 'article';
}
const { title = site.title, description = site.description, dark = false, image, type = 'website' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={url('favicon.svg')} />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {image && <meta property="og:image" content={image} />}
    <meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />
    <title>{title}</title>
  </head>
  <body class:list={{ 'has-dark-hero': dark }}>
    <header class="site-header">
      <a class="brand" href={url()}>{site.brand}</a>
      <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="main-nav">Menu</button>
      <nav id="main-nav" aria-label="Main">
        {nav.map((n) => <a href={n.href ?? url(n.path)}>{n.label}</a>)}
        <a class="nav-cta" href={url('contact')}>Get In Touch</a>
      </nav>
      <a class="btn header-cta" href={url('contact')}>Get In Touch</a>
    </header>

    <main><slot /></main>

    <footer class="site-footer">
      <div class="footer-inner">
        <div>
          <p class="footer-title">Jude Myers Design.</p>
          <p>Have a project in mind? <a href={url('contact')}>Get in touch here</a>.</p>
          <ul class="socials">
            {socials.map((s) => <li><a href={s.href} target="_blank" rel="noopener">{s.label}</a></li>)}
          </ul>
        </div>
        <nav aria-label="Footer">
          {nav.filter((n) => n.path).map((n) => <a href={url(n.path)}>{n.label}</a>)}
        </nav>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --ink: #1a1714;
    --cream: #f5f0eb;
    --page: #d3cecA;
    --blue: #2851cc;
    --sans: 'IBM Plex Sans', system-ui, sans-serif;
    --mono: 'IBM Plex Mono', ui-monospace, monospace;
  }
  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body {
    margin: 0;
    background-color: var(--page);
    color: var(--ink);
    font: 14px/1.6 var(--mono);
  }
  h1, h2, h3, h4 { font-family: var(--sans); font-weight: 700; margin: 0 0 1rem; line-height: 1.05; }
  h1 { font-size: clamp(2.6rem, 10vw, 9.3rem); letter-spacing: -0.02em; }
  h2 { font-size: clamp(2rem, 4vw, 3.2rem); letter-spacing: -0.02em; }
  h3 { font-size: 1.9rem; letter-spacing: -0.02em; }
  a { color: inherit; }
  img { display: block; max-width: 100%; }

  .dots {
    background-color: var(--cream);
    background-image: radial-gradient(rgba(26, 23, 20, 0.22) 1px, transparent 1.5px);
    background-size: 28px 28px;
  }
  .dots-dark {
    background-color: var(--ink);
    background-image: radial-gradient(rgba(245, 240, 235, 0.16) 1px, transparent 1.5px);
    background-size: 28px 28px;
    color: var(--cream);
  }
  .wrap { max-width: 1400px; margin: 0 auto; padding: 0 clamp(1rem, 3vw, 2.5rem); }
  .btn {
    display: inline-block;
    padding: 0.8rem 1.6rem;
    background: var(--blue);
    color: var(--cream);
    font: 700 1.1rem var(--mono);
    text-decoration: none;
    border-radius: 6px;
    transition: background 0.15s;
  }
  .btn:hover { background: #1d3d9e; }

  .site-header {
    position: absolute;
    inset: 0 0 auto 0;
    z-index: 10;
    display: flex;
    align-items: center;
    gap: 2rem;
    padding: 1rem clamp(1rem, 3vw, 2.5rem);
    color: var(--ink);
  }
  .has-dark-hero .site-header { color: var(--cream); }
  .site-header .brand { font: 700 1.8rem var(--sans); letter-spacing: -0.02em; text-decoration: none; margin-right: auto; }
  .site-header nav { display: flex; gap: 1.5rem; flex-wrap: wrap; font-size: 1.1rem; }
  .site-header nav a { text-decoration: none; }
  .site-header nav a:hover { text-decoration: underline; }
  .menu-toggle, .nav-cta { display: none; }
  @media (max-width: 960px) {
    .header-cta { display: none; }
    .menu-toggle {
      display: block; padding: 0.4rem 0.9rem;
      background: none; color: inherit; border: 1px solid currentColor; border-radius: 6px;
      font: 700 1rem var(--mono); cursor: pointer;
    }
    .site-header nav {
      display: none; position: absolute; top: 100%; left: 0; right: 0;
      flex-direction: column; gap: 0; padding: 0.5rem clamp(1rem, 3vw, 2.5rem) 1rem;
      background: var(--ink); color: var(--cream);
    }
    .site-header.open nav { display: flex; }
    .site-header nav a { padding: 0.7rem 0; border-bottom: 1px solid rgba(245, 240, 235, 0.15); }
    .nav-cta { display: block; }
  }

  .prose { max-width: 70ch; font-size: 1.1rem; }
  .prose h2, .prose h3 { margin-top: 2rem; }
  .prose img { max-width: 100%; height: auto; margin: 1.25rem 0; }
  .prose iframe { width: 100%; max-width: 720px; aspect-ratio: 16 / 9; height: auto; border: 0; margin: 1.25rem 0; }
  .prose a { color: var(--blue); }
  .prose blockquote { margin: 1.25rem 0; padding-left: 1rem; border-left: 3px solid var(--ink); }
  .page-title { padding: 9rem 0 2rem; }
  .site-footer { background: var(--ink); color: var(--cream); margin-top: 4rem; padding: 3rem 0; }
  .footer-inner {
    max-width: 1400px; margin: 0 auto; padding: 0 clamp(1rem, 3vw, 2.5rem);
    display: flex; justify-content: space-between; gap: 2rem; flex-wrap: wrap;
  }
  .footer-title { font: 700 1.8rem var(--sans); margin: 0 0 0.5rem; }
  .site-footer nav { display: flex; flex-direction: column; gap: 0.4rem; }
  .socials { list-style: none; display: flex; gap: 1rem; padding: 0; margin: 1rem 0 0; }
</style>

<script>
  const header = document.querySelector<HTMLElement>('.site-header')!;
  const toggle = header.querySelector<HTMLButtonElement>('.menu-toggle')!;
  toggle.addEventListener('click', () => {
    const open = header.classList.toggle('open');
    toggle.setAttribute('aria-expanded', String(open));
  });
</script>
