---
import { profile } from '../data/site';

interface Props {
  title?: string;
  description?: string;
}
const { title = `${profile.name} · ${profile.role}`, description = profile.tagline } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href={`${base}/`}>{profile.name}</a>
      <nav>
        <a href="#projects">Projects</a>
        <a href="#about">About</a>
        <a href="#contact">Contact</a>
      </nav>
    </header>
    <main><slot /></main>
    <footer>© {new Date().getFullYear()} {profile.name}</footer>
  </body>
</html>

<style is:global>
  :root {
    --bg: #fafafa;
    --fg: #16161d;
    --muted: #5c5c6b;
    --card: #fff;
    --border: #e4e4ec;
    --accent: #6d5efc;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #0f0f14;
      --fg: #ececf3;
      --muted: #9a9aad;
      --card: #17171f;
      --border: #272733;
      --accent: #9a8fff;
    }
  }
  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--fg);
    font: 16px/1.65 system-ui, -apple-system, 'Segoe UI', sans-serif;
  }
  a { color: var(--accent); }
  .site-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    max-width: 880px;
    margin: 0 auto;
    padding: 1.25rem 1.5rem;
  }
  .site-header nav { display: flex; gap: 1.25rem; }
  .site-header a { text-decoration: none; color: var(--muted); }
  .site-header a:hover, .site-header .brand { color: var(--fg); }
  .brand { font-weight: 700; }
  main { max-width: 880px; margin: 0 auto; padding: 0 1.5rem; }
  section { padding: 3rem 0; }
  h1 { font-size: clamp(2.2rem, 6vw, 3.5rem); line-height: 1.1; margin: 0 0 1rem; }
  h2 { font-size: 1.5rem; margin: 0 0 1.5rem; }
  footer {
    max-width: 880px;
    margin: 2rem auto 0;
    padding: 2rem 1.5rem;
    color: var(--muted);
    border-top: 1px solid var(--border);
    font-size: 0.9rem;
  }
</style>
