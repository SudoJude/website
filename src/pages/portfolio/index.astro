---
import Layout from '../../layouts/Layout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { getProjects, slugOf } from '../../lib/content';

const projects = await getProjects();
---

<Layout title="Portfolio | Jude Myers">
  <div class="wrap">
    <h1 class="page-title">Projects &amp; Portfolio</h1>
    <div class="grid">
      {projects.map((p) => <ProjectCard slug={slugOf(p.id)} title={p.data.title} image={p.data.cover} alt={p.data.coverAlt} />)}
    </div>
  </div>
</Layout>

<style>
  .page-title { font-size: clamp(2.4rem, 6vw, 4.5rem); }
  .grid { display: flex; flex-wrap: wrap; gap: 1.5rem; }
</style>
