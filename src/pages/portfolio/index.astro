---
import Layout from '../../layouts/Layout.astro';
import Picture from '../../components/Picture.astro';
import PageHero from '../../components/PageHero.astro';
import { url } from '../../data/site';
import { getProjects, slugOf } from '../../lib/content';

const projects = await getProjects();
---

<Layout title="Portfolio | Jude Myers" dark>
  <PageHero title="Projects & Portfolio" />

  <section class="list dots">
    <div class="grid">
      {
        projects.map((p) => (
          <a class="item" href={url(`portfolio/${slugOf(p.id)}`)}>
            {p.data.cover ? <Picture class="cover" src={p.data.cover} alt={p.data.coverAlt} width={1000} /> : <div class="cover ph" />}
            <h3>{p.data.title}</h3>
          </a>
        ))
      }
    </div>
  </section>
</Layout>

<style>
  .list { padding: 3rem 4%; }
  .grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 2.8rem 2%; }
  .item { display: block; text-decoration: none; color: inherit; }
  /* Covers are 16:9 (1920x1080) */
  .item :global(.cover) {
    width: 100%; aspect-ratio: 16 / 9; object-fit: cover; display: block;
    /* Soft shadow; the cover lifts slightly when the card is hovered or focused (same effect as /blog) */
    box-shadow: 0 2px 6px rgba(26, 23, 20, 0.12), 0 6px 16px rgba(26, 23, 20, 0.08);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .item:hover :global(.cover),
  .item:focus-visible :global(.cover) {
    transform: translateY(-4px);
    box-shadow: 0 6px 12px rgba(26, 23, 20, 0.16), 0 14px 28px rgba(26, 23, 20, 0.12);
  }
  @media (prefers-reduced-motion: reduce) {
    .item :global(.cover) { transition: none; }
    .item:hover :global(.cover), .item:focus-visible :global(.cover) { transform: none; }
  }
  .ph { background: rgba(26, 23, 20, 0.1); }
  .item h3 { font-size: clamp(1.4rem, 2.1vw, 1.9rem); margin: 1.25rem 0 0; line-height: 1.2; }

  @media (max-width: 900px) { .grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 600px) { .grid { grid-template-columns: 1fr; } .list { padding: 1.5rem 6% 3rem; } }

  /* The original page runs straight into the footer */
  :global(.site-footer) { margin-top: 0; }
</style>
