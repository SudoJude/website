---
import { render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import '../../components/carousel.css';
import { url } from '../../data/site';
import { getProjects, slugOf } from '../../lib/content';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project) => ({ params: { slug: slugOf(project.id) }, props: { project } }));
}
const { project } = Astro.props;
const { Content } = await render(project);
const { heading, title, tagline, details } = project.data;
---

<Layout title={`${title} | Jude Myers`} dark>
  <section class="hero dots-dark">
    <div class="inner">
      <h1>{heading ?? title}</h1>
      {tagline && <h4>{tagline}</h4>}
    </div>
    {
      details.length > 0 && (
        <div class="marquee" aria-label={details.join(', ')}>
          <div class="marquee-track" aria-hidden="true">
            {[0, 1].map(() => <span>{details.map((d) => <span>{d}</span>)}</span>)}
          </div>
        </div>
      )
    }
  </section>

  <div class="body dots">
    <div class="content"><Content /></div>
    <p class="back"><a class="btn" href={url('portfolio')}>← All Projects</a></p>
  </div>
</Layout>

<style>
  .hero { padding: 9rem 0 0; overflow: hidden; }
  .inner { padding: 0 4%; }
  .hero h1 { font-size: clamp(2.4rem, 5vw, 4.5rem); margin-bottom: 0.6rem; }
  .hero h4 { font-size: clamp(1.2rem, 2.1vw, 1.9rem); max-width: 60rem; margin-bottom: 0; }
  .marquee { margin-top: 1.5rem; padding: 1.2rem 0 1.6rem; overflow: hidden; white-space: nowrap; }
  .marquee-track { display: inline-flex; animation: scroll 40s linear infinite; font-size: clamp(1rem, 1.7vw, 1.6rem); }
  .marquee-track > span { display: inline-flex; flex: none; }
  .marquee-track > span > span { padding: 0 1.6rem; }
  .marquee-track > span > span::after { content: '|'; margin-left: 3.2rem; opacity: 0.6; }
  @keyframes scroll { to { transform: translateX(-50%); } }
  @media (prefers-reduced-motion: reduce) { .marquee-track { animation: none; } }

  .body { padding: 2rem 0 4rem; }
  .content, .back { padding: 0 4%; }
  .back { margin-top: 3rem; }

  /* Markdown body (elements are generated, so :global) */
  .content :global(h2) {
    font-size: clamp(2rem, 3.6vw, 3.2rem);
    margin: 0 0 1rem;
    padding-top: 2.5rem;
  }
  .content :global(h2:not(:first-child)) { margin-top: 3rem; border-top: 1px solid var(--ink); padding-top: 5rem; }
  .content :global(p) { font-size: clamp(1rem, 1.4vw, 1.25rem); line-height: 1.5; margin: 0 0 1.2rem; }
  .content :global(.btn-row) { margin: 2rem 0; }
  .content :global(.btn) { color: var(--cream); text-decoration: none; }
  .content :global(p > img) { max-width: min(100%, 1000px); height: auto; margin: 1.5rem auto; }

  /* Galleries are carousels (markup from the rehype plugin); here they just go full width */
  .content :global(.project-gallery) { margin: 2rem -4vw; }
</style>

<script>
  import '../../components/carousel.ts';
</script>
