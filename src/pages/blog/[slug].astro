---
import Layout from '../../layouts/Layout.astro';
import { posts, url } from '../../data/site';

export function getStaticPaths() {
  return posts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}
const { post } = Astro.props;
---

<Layout title={`${post.title} | Jude Myers`}>
  <div class="wrap">
    <h1 class="page-title">{post.title}</h1>
    <p class="meta">Jude · {new Date(post.date).toLocaleDateString('en-GB')}</p>
    <img src={`${post.image}?format=1500w`} alt="" />
    <p class="body">{post.excerpt}</p>
    <p><a class="btn" href={url('blog')}>← All Posts</a></p>
  </div>
</Layout>

<style>
  .page-title { font-size: clamp(2.2rem, 5vw, 4rem); }
  .meta { opacity: 0.7; }
  img { width: 100%; max-width: 900px; margin: 1rem 0; }
  .body { max-width: 65ch; font-size: 1.1rem; }
</style>
