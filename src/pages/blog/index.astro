---
import Layout from '../../layouts/Layout.astro';
import Picture from '../../components/Picture.astro';
import { url } from '../../data/site';
import { getPosts, slugOf, excerptOf } from '../../lib/content';

const posts = await getPosts();
---

<Layout title="Blog | Jude Myers">
  <div class="wrap">
    <h1 class="page-title">Blogs &amp; Case Studies</h1>
    <div class="list">
      {posts.map((p) => (
        <article>
          <a href={url(`blog/${slugOf(p.id)}`)}>
            {p.data.cover ? <Picture src={p.data.cover} alt={p.data.coverAlt} width={500} /> : <div class="ph" />}
          </a>
          <div>
            <p class="meta">Jude · {p.data.date.toLocaleDateString('en-GB')}</p>
            <h2><a href={url(`blog/${slugOf(p.id)}`)}>{p.data.title}</a></h2>
            <p>{excerptOf(p)}</p>
            <a href={url(`blog/${slugOf(p.id)}`)}>Read More</a>
          </div>
        </article>
      ))}
    </div>
  </div>
</Layout>

<style>
  .page-title { font-size: clamp(2.4rem, 6vw, 4.5rem); }
  .list { display: grid; gap: 2.5rem; }
  article { display: grid; grid-template-columns: minmax(200px, 1fr) 2fr; gap: 2rem; }
  article :global(img), .ph { width: 100%; aspect-ratio: 16 / 10; object-fit: cover; background: var(--ink); }
  h2 { font-size: 2rem; }
  h2 a { text-decoration: none; }
  .meta { opacity: 0.7; margin: 0 0 0.5rem; }
  @media (max-width: 700px) { article { grid-template-columns: 1fr; } }
</style>
