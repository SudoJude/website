---
import Layout from '../layouts/Layout.astro';
import { url } from '../data/site';
---

<Layout title="Page not found | Jude Myers">
  <div class="wrap">
    <h1 class="page-title">404</h1>
    <p>That page doesn't exist (or has moved).</p>
    <p><a class="btn" href={url()}>← Back home</a></p>
  </div>
</Layout>

<style>
  .page-title { font-size: clamp(3rem, 12vw, 8rem); }
</style>
