---
import Layout from '../layouts/Layout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { profile, projects } from '../data/site';
---

<Layout>
  <section class="hero">
    <p class="role">{profile.role}</p>
    <h1>Hi, I'm {profile.name}.</h1>
    <p class="tagline">{profile.tagline}</p>
  </section>

  <section id="projects">
    <h2>Projects</h2>
    <div class="grid">
      {projects.map((p) => <ProjectCard {...p} />)}
    </div>
  </section>

  <section id="about">
    <h2>About</h2>
    {profile.about.map((para) => <p>{para}</p>)}
  </section>

  <section id="contact">
    <h2>Contact</h2>
    <p>
      <a href={`mailto:${profile.email}`}>{profile.email}</a>
    </p>
    <p>
      {profile.links.map((l, i) => (
        <>
          {i > 0 && ' · '}
          <a href={l.href} target="_blank" rel="noopener">{l.label}</a>
        </>
      ))}
    </p>
  </section>
</Layout>

<style>
  .hero { padding-top: 4rem; }
  .role { color: var(--accent); font-weight: 600; margin: 0 0 0.5rem; }
  .tagline { font-size: 1.25rem; color: var(--muted); max-width: 36rem; }
  .grid { display: grid; gap: 1rem; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); }
</style>
