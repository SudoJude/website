---
import Layout from '../layouts/Layout.astro';
import Carousel from '../components/Carousel.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Picture from '../components/Picture.astro';
import { hero, url } from '../data/site';
import { getProjects, getPosts, getPhotos, slugOf, formatDate } from '../lib/content';

const projects = (await getProjects()).filter((p) => p.data.featured);
const posts = (await getPosts()).slice(0, 3);
const photos = (await getPhotos()).filter((p) => p.data.featured);
---

<Layout dark>
  <section class="hero dots-dark">
    <div class="wrap">
      <h1>{hero.heading}</h1>
      <p>{hero.text}</p>
    </div>
  </section>

  <section class="wrap block">
    <h2 class="big">Featured Projects</h2>
    <Carousel>
      {projects.map((p) => (
        <ProjectCard slug={slugOf(p.id)} title={p.data.shortTitle ?? p.data.title} image={p.data.cover} alt={p.data.coverAlt} />
      ))}
    </Carousel>
    <p class="more"><a class="btn" href={url('portfolio')}>View All Projects</a></p>
  </section>

  <section class="blogs dots">
    <div class="wrap block">
      <h2 class="big">Recent Blogs &amp; Case Studies</h2>
      <div class="post-grid">
        {posts.map((p) => (
          <a class="post" href={url(`blog/${slugOf(p.id)}`)}>
            {p.data.cover && <Picture src={p.data.cover} alt={p.data.coverAlt} width={500} />}
            <time datetime={p.data.date.toISOString()}>{formatDate(p.data.date)}</time>
            <h3>{p.data.title}</h3>
            <span>Read more →</span>
          </a>
        ))}
      </div>
      <p class="more"><a class="btn" href={url('blog')}>View All Blogs</a></p>
    </div>
  </section>

  <section class="block">
    <div class="wrap"><h2 class="big">Featured Photography</h2></div>
    <Carousel>
      {photos.map((p) => <Picture class="photo" src={p.data.image} alt={p.data.alt} />)}
    </Carousel>
    <p class="more wrap"><a class="btn" href={url('photography')}>View All Photography</a></p>
  </section>
</Layout>

<style>
  .hero { min-height: 540px; display: grid; align-items: center; padding: 7rem 0 4rem; text-align: center; }
  .hero p { max-width: 62ch; margin: 1.5rem auto 0; font-size: 1.25rem; }
  .block { padding: 4rem 0; }
  .big { font-size: clamp(2.2rem, 5vw, 3.2rem); }
  .more { margin: 2rem 0 0; text-align: center; }
  .blogs .block { padding: 4rem clamp(1rem, 3vw, 2.5rem); }
  .post-grid { display: grid; gap: 2rem; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); }
  .post { text-decoration: none; display: flex; flex-direction: column; gap: 0.5rem; }
  .post :global(img) { width: 100%; aspect-ratio: 16 / 10; object-fit: cover; }
  .post time { opacity: 0.7; }
  .post h3 { font-size: 1.6rem; margin: 0; }
  .block :global(.photo) { height: 340px; width: auto; max-width: none; aspect-ratio: auto 3 / 2; }
</style>
